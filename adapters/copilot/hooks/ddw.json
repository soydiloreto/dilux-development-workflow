{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash .github/hooks/ddw/session-start.sh",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "bash .github/hooks/ddw/pre-tool-use.sh",
        "timeoutSec": 15
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "bash .github/hooks/ddw/post-write.sh",
        "timeoutSec": 15
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "bash": "bash .github/hooks/ddw/pre-compact.sh",
        "timeoutSec": 10
      }
    ]
  }
}
